# Снап настольной версии. Собирает его ./pack.sh snap из готового
# vv.deb — из того же файла, что раздаётся отдельно: в магазине и в
# пакете должна быть ровно одна программа, а не две похожие.
#
# @VERSION@ подставляет pack.sh, чтобы версия шла из brand.go и не
# расходилась с тем, что показывает сама программа.
#
# Строгий снап. Classic в магазине для VPN-клиента не дают (см.
# SNAP.md), и он не нужен:
#
# * окно — своё, vv-window на WebKitGTK из gnome-42-2204: браузеров
#   хозяина из строгого снапа не видно, а вкладка вместо окна — не то;
# * режим VPN поднимает служба с разрешением network-control. ip,
#   sysctl и resolvectl берутся из core22 — это корень строгого снапа,
#   хозяйские ей не нужны. Метки на пакеты в снапе нет и не было:
#   соединение с сервером уводит мимо туннеля маршрут (routeBypass).
name: vibevpn
title: VibeVPN
version: '@VERSION@'
summary: VPN без регистрации — ни почты, ни телефона
# Значок для магазина и «Центра приложений». Без него там серый круг:
# значок из пакета стоит на ярлыке в меню, а витрина берёт только этот.
# Кладёт его рядом с описанием pack.sh.
icon: icon.png
# Своего кода у нас никто не лицензировал, и «unset» в витрине выглядит
# недоделкой. Ядро (Xray) и туннель (tun2socks) лежат внутри
# отдельными программами под своими лицензиями — MPL-2.0 и GPL-3.0.
license: Proprietary
website: https://vv.t-forge.online
contact: https://vv.t-forge.online
source-code: https://github.com/vibeVpnT/vibeVpnT
issues: https://github.com/vibeVpnT/vibeVpnT/issues
description: |
  VPN без регистрации: ни почты, ни телефона, ни анкет. Подписка
  выдаётся при первом запуске мобильного приложения — семь дней и
  30 ГБ, чтобы было чем проверить.

  Настольная версия входит по коду с телефона: показывает QR, вы
  сканируете его тем телефоном, где подписка уже есть, — и это одна
  подписка на оба устройства.

  Трафик ловится двумя способами, и человек выбирает их тумблером.
  Обычный — системный прокси: его слушают браузеры и всё, что умеет
  спрашивать систему. Режим VPN поднимает сетевой интерфейс и
  заворачивает в туннель весь трафик машины разом, включая программы,
  которые про прокси слыхом не слыхивали.

  Российские сайты, банки и госуслуги при этом ходят напрямую, мимо
  туннеля: иначе они попросту не открываются. Список обновляется с
  сервера, руками настраивать ничего не нужно.

  Сервер выбирается сам, но его можно сменить вручную — список с
  задержками показан в окне.

  Сайт: https://vv.t-forge.online
  Исходный код: https://github.com/vibeVpnT/vibeVpnT
grade: stable
confinement: strict
base: core22

apps:
  vibevpn:
    command: opt/vv/vv
    desktop: usr/share/applications/vv.desktop
    # То, во что развернулось бы расширение gnome (snapcraft
    # expand-extensions), — только записанное явно: часть расширения не
    # собирается make свежих Ubuntu (см. parts ниже). desktop-launch
    # настраивает окну GTK, WebKitGTK, шрифты и темы; gsettings — ещё и
    # системный прокси, он правится через тот же gsettings.
    command-chain:
      - snap/command-chain/desktop-launch
    plugs:
      - desktop
      - desktop-legacy
      - gsettings
      - opengl
      - wayland
      - x11
      - network
      - network-bind
    environment:
      # Иначе на части видеокарт WebKitGTK в снапе рисует пустое окно.
      WEBKIT_DISABLE_DMABUF_RENDERER: "1"

  # Режим VPN: туннель и маршруты, всё это от root.
  #
  # Служба работает всегда и ждёт, пока понадобится: командовать
  # службами снапа может только root, а программа работает от обычного
  # пользователя — snapd на просьбу «запусти» отвечает отказом, даже
  # пароля не спрашивая. Поэтому решение принимает сама служба: раз в
  # секунду спрашивает окно, нужен ли туннель. Пока не нужен, она
  # ничего не делает и ничего не трогает.
  tun:
    command: opt/vv/vv --tun-run
    daemon: simple
    install-mode: enable
    restart-condition: on-failure
    restart-delay: 5s
    # network-control — сетевой интерфейс туннеля и маршруты. Само оно
    # не подключается: sudo snap connect vibevpn:network-control (окно
    # подскажет), пока магазин не одобрит автоподключение.
    plugs:
      - network
      - network-bind
      - network-control

# Библиотеки окна — WebKitGTK и всё, что под ним, — из gnome-42-2204,
# плюс темы и значки. Тоже из расширения gnome.
plugs:
  gnome-42-2204:
    interface: content
    target: $SNAP/gnome-platform
    default-provider: gnome-42-2204
  gtk-3-themes:
    interface: content
    target: $SNAP/data-dir/themes
    default-provider: gtk-common-themes
  icon-themes:
    interface: content
    target: $SNAP/data-dir/icons
    default-provider: gtk-common-themes
  sound-themes:
    interface: content
    target: $SNAP/data-dir/sounds
    default-provider: gtk-common-themes

environment:
  SNAP_DESKTOP_RUNTIME: $SNAP/gnome-platform
  GTK_USE_PORTAL: "1"

# WebKitGTK ищет свои вспомогательные процессы по пути, зашитому при
# сборке, — туда и кладём их из gnome-42-2204.
layout:
  /usr/lib/x86_64-linux-gnu/webkit2gtk-4.1:
    bind: $SNAP/gnome-platform/usr/lib/x86_64-linux-gnu/webkit2gtk-4.1
  /usr/lib/x86_64-linux-gnu/webkit2gtk-4.0:
    bind: $SNAP/gnome-platform/usr/lib/x86_64-linux-gnu/webkit2gtk-4.0
  /usr/lib/x86_64-linux-gnu/libproxy:
    bind: $SNAP/gnome-platform/usr/lib/x86_64-linux-gnu/libproxy
  /usr/share/libdrm:
    bind: $SNAP/gnome-platform/usr/share/libdrm
  /usr/share/xml/iso-codes:
    bind: $SNAP/gnome-platform/usr/share/xml/iso-codes

parts:
  # desktop-launch и его run — вместо части gnome/sdk расширения. У той
  # Makefile начинается с шаблона «*:», а make свежих Ubuntu раскрывает
  # его в имена файлов и ставит их мимо снапа, в /snap/command-chain
  # хозяина. Скрипты крошечные — проще положить свои.
  launch:
    plugin: dump
    source: ./snap-launch
    organize:
      "*": snap/command-chain/

  # Окно, собранное window/build.sh, — к программе, в opt/vv.
  window:
    plugin: dump
    source: ./window
    organize:
      vv-window: opt/vv/vv-window

  app:
    plugin: dump
    source: ./vv.deb
    source-type: deb
    override-prime: |
      craftctl default

      # Ссылка /usr/bin/vv ведёт в /opt/vv — в снапе это путь хозяина,
      # а не наш. Службу systemd из пакета тоже убираем: в снапе за
      # службы отвечает snapd, и своя у него уже объявлена выше.
      rm -f usr/bin/vv
      rm -rf lib/systemd

      # Exec=vibevpn — имя команды снапа: только такую строку snapd
      # принимает, когда переносит ярлык в меню, а путь из пакета
      # молча выбрасывает. ${SNAP} в значке он подставляет сам.
      #
      # Имя в меню — человеческое: в пакете ярлык называется по имени
      # файла, а из магазина программу ставят по названию и ищут потом
      # тоже по нему.
      sed -i \
        -e 's|^Exec=/opt/vv/vv|Exec=vibevpn|' \
        -e 's|^Name=vv$|Name=VibeVPN|' \
        -e 's|^Icon=.*|Icon=${SNAP}/usr/share/icons/hicolor/512x512/apps/vv.png|' \
        usr/share/applications/vv.desktop
