# Собранное и скачанное. Всё это появляется само: ядро и туннель
# скачиваются сборочными скриптами из релизов, сборки складываются в
# dist и build. В репозитории им делать нечего — он не склад.

# --- Общее -------------------------------------------------------------
dist/
build/
*.apk
*.deb
*.exe
*.zip
*.aar

# --- Android -----------------------------------------------------------
.gradle/
local.properties
V2rayNG/app/libs/
V2rayNG/.idea/
captures/
# Ядро xray для телефона: его скачивает build.sh из релиза.
AndroidLibXrayLite/
# Ключ подписи никогда не попадает в репозиторий: он лежит вне его, на
# сборочной машине. Потерять его нельзя — без него не выпустить
# обновление поверх установленного.
*.jks
*.keystore

# --- Настольная версия -------------------------------------------------
# Ядро, туннель и справочники: их кладёт pack.sh, качая из релизов.
desktop/assets/xray
desktop/assets/xray.exe
desktop/assets/tun2socks
desktop/assets/tun2socks.exe
desktop/assets/wintun.dll
desktop/assets/*.gz
desktop/assets/geosite.dat
desktop/assets/geoip.dat

# --- Мусор редакторов и систем -----------------------------------------
.DS_Store
*.swp
.idea/
.vscode/

# Дампы упавших программ: makensis однажды уронил ядро прямо сюда.
# Только файлы: каталоги с именем core — исходники (ang/core в Android,
# src/core в hev-socks5-tunnel), без них приложение не собрать. И только
# дампы с номером процесса — core.version нужен сборке.
core
!core/
core.[0-9]*
